@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">User Management WebApp</h1>
        <p class="lead text-muted mt-3">
            A simple but powerful ASP.NET Core MVC application to manage users efficiently.
            Create, edit, delete, and view all users with ease.
        </p>
        <a href="/Users" class="btn btn-lg btn-success mt-3">🚀 Try It Now</a>
    </div>

    <!-- Features Section -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">📋 User Profiles</h5>
                    <p class="card-text">Add and manage user details like Name, Age, Email, and Score.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">⚡ Easy Management</h5>
                    <p class="card-text">Quickly edit or delete user records with a clean UI.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">📊 Organized Data</h5>
                    <p class="card-text">Keep track of your users in a structured and responsive layout.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- About Project Section -->
    <div class="bg-light p-5 rounded shadow-sm">
        <h2 class="fw-bold text-center text-secondary mb-4">About This Project</h2>
        <p class="text-center text-muted">
            This project was built as part of a practice series to improve full-stack web development skills.
            It demonstrates the use of ASP.NET Core MVC, Entity Framework Core, and Bootstrap for styling.
        </p>
    </div>
</div>
